<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!-- 1. Thông tin chung của Server và Database (Dễ dàng đổi tên máy khi đi chấm đồ án) -->
	<appSettings>
		<add key="ServerName" value=".\SQLEXPRESS" />
		<add key="DatabaseName" value="CineStarDB" />
		<add key="MaxSeatPerTransaction" value="8" />
	</appSettings>

	<!-- 2. Chuỗi kết nối phân theo từng Role CSDL (Admin và User) -->
	<connectionStrings>
		<add name="CineStar_Admin"
			 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=CineStarDB;User ID=Login_CineStar_Admin;Password=AdminPassword@2026!;TrustServerCertificate=True;Connect Timeout=15"
			 providerName="Microsoft.Data.SqlClient" />

		<add name="CineStar_User"
			 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=CineStarDB;User ID=Login_CineStar_User;Password=UserPassword@2026!;TrustServerCertificate=True;Connect Timeout=15"
			 providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
</configuration>